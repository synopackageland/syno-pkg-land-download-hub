# Store text: the catalog's catalog.yaml (schema 4) that check, build and
# inspect read for descriptions and release notes (or pass --catalog).
# SYNOPKGLAND_CATALOG=/path/to/catalog/catalog.yaml
# pnpm run e2e:nas reads .env (ignored by Git). No secrets here: accounts come
# from the private account files below (mode 600).
# SSH host of the tunnel to the NAS (the browser never connects directly).
DSM_E2E_SSH=root@nas.example.invalid
# Local end of the tunnel (default: a free loopback port).
# DSM_E2E_TUNNEL_PORT=15000
# The agent's model: magpie's GPT-6 Luna at max reasoning effort.
E2E_LLM_BASE_URL=http://127.0.0.1:3425/v1
E2E_LLM_MODEL=codex/gpt-6-luna
E2E_LLM_REASONING_EFFORT=max
# Account files: {"username","password"} and {"users":{"normal1":{...}}}.
DSM_E2E_ACCOUNT_ADMIN=/path/to/private/accounts/test-nas-admin.json
DSM_E2E_ACCOUNT_NORMAL1=/path/to/private/accounts/test-nas-normal-users.json
# Signed-in DSM profiles kept between runs: <dir>/test-nas-<user>.json (default ~/.cache/synopkgland-e2e).
# DSM_E2E_PROFILE_DIR=
# Names the fixtures (folders, files) the suites create and remove.
E2E_FIXTURE_TAG=e2e
# 1 skips the tests that change the App's state for other users.
# E2E_KEEP_APP_STATE=1
