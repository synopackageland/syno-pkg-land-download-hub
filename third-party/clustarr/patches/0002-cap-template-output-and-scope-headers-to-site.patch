@@ -220,0 +225,19 @@ func renderModified(tmplText string, tc *TemplateContext, modifier func(string)
+// maxTemplateOutput bounds what one template may produce: a few bytes of
+// nested range or repeat actions can otherwise expand into gigabytes.
+const maxTemplateOutput = 1 << 20
+
+var errTemplateOutputTooLarge = errors.New("cardigann: template output too large")
+
+// cappedWriter fails a write that would take buf past max.
+type cappedWriter struct {
+	buf *bytes.Buffer
+	max int
+}
+
+func (w *cappedWriter) Write(p []byte) (int, error) {
+	if w.buf.Len()+len(p) > w.max {
+		return 0, errTemplateOutputTooLarge
+	}
+	return w.buf.Write(p)
+}
